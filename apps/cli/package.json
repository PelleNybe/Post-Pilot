{
  "name": "postpilot",
  "version": "2.0.5",
  "description": "PostPilot CLI - Command line interface for the PostPilot social media scheduling API",
  "main": "dist/index.js",
  "bin": {
    "postpilot": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "node ./dist/index.js",
    "publish": "tsup && pnpm publish --access public --no-git-checks"
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md"
  ],
  "keywords": [
    "postpilot",
    "cli",
    "social media",
    "scheduling",
    "automation",
    "ai-agent",
    "command-line"
  ],
  "author": "Corax CoLAB",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/PelleNybe/Post-Pilot.git",
    "directory": "apps/cli"
  },
  "homepage": "https://coraxcolab.com",
  "bugs": {
    "url": "https://github.com/PelleNybe/Post-Pilot/issues"
  },
  "dependencies": {
    "node-fetch": "^3.3.2",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.32",
    "tsup": "^9.0.0"
  }
}
